# OPTIONAL. The app works WITHOUT any key: by default it uses the free Google Translate endpoint.
# To use an official translation API instead, copy this file to a new file named ".env"
# and fill in ONE of the options below. Then restart the app.

# Option 1: Microsoft Translator (Azure AI Translator). The free tier (F0) gives 2 million characters a month.
# Key and region are on your Translator resource's "Keys and Endpoint" page in the Azure portal.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Option 2: Google Cloud Translation API (needs a Google Cloud project with billing turned on).
GOOGLE_TRANSLATE_API_KEY=
